# TaskVault API. Copy to .env for local dev. NEVER commit real values.

# Postgres. Prod: the `taskvault` database on the shared 3pandalabs-postgres
# instance, as the `taskvault_app` role (which owns the database).
# Local: docker-compose.dev.yml (host port 5436).
DATABASE_URL=postgres://taskvault:taskvault@localhost:5436/taskvault
# Do NOT set MIGRATION_DATABASE_URL: there is no role split (42501 gotcha).

PORT=8080

# Access-token signing secret (refresh tokens are opaque, bcrypt-hashed rows).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# The web app's origin: CORS allow-list + links in emails (reset, reminders).
# http://localhost:3000 is always allowed for local dev.
WEB_URL=http://localhost:3000
# Optional extra comma-separated CORS origins (previews).
CORS_ORIGINS=

# Optional. Shared secret a web Worker would send as X-Internal-Secret (with
# X-Client-IP) so the forwarded IP is trusted for rate limiting.
INTERNAL_SHARED_SECRET=

# Reminders + daily digest sweep (every 15 min inside the API). Set to false to turn off.
REMINDERS_ENABLED=true

# Mail is OPTIONAL. With none of the below set, mail is disabled (logged, skipped).
# SMTP (Gmail app password for 3pandalabs@gmail.com, port 587 STARTTLS).
# When USER+PASS are set, mail goes over SMTP and the gateway is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Fallback: shared org mail gateway (3pandalabs/mailer), app key "taskvault".
MAILER_URL=https://mailer.3pandalabs.com
MAILER_TOKEN=
EMAIL_FROM_NAME=TaskVault

# Ops-only GET /metrics bearer token (shared across org apps). Blank -> 503.
METRICS_TOKEN=

# `npm run db:seed` only (never read by the API). JSON array; passwords >= 8 chars.
# Existing users (matched by email) keep their password.
# SEED_USERS=[{"email":"a@example.com","name":"A","password":"change-me-please","timezone":"America/New_York"}]
SEED_USERS=
SEED_HOUSEHOLD_NAME=Home
